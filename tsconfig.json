{
  /*
   * Type-checking and declaration emit for the pure-JS sources: tsc reads the
   * JSDoc annotations in `lib/` and emits `.d.ts` files to `dist/types/`.
   * The runtime CJS output is untouched.
   * See `.shreni/design/2026-09-21-ts-declarations-from-jsdoc.md`.
   */
  "compilerOptions": {
    "allowJs": true,

    /*
     * Checking is opted into per file with a `// @ts-check` pragma on line 1,
     * NOT by `include`. `include` only picks the program's roots; tsc then
     * pulls in everything they `require()` transitively and checks that too.
     * `lib/config/default-config.js` requires `../rules` and `../languages/js`,
     * so covering `lib/config/**` drags the whole `lib/` tree into the program
     * and a global `checkJs` would report ~4,000 errors in modules later beads
     * own. There is no way to exclude a transitively-reached file, so the
     * pragma is the only mechanism that scopes checking to annotated sources.
     *
     * `tests/tools/tsc-pipeline.js` pins the two halves together: every `.js`
     * file under an `include` directory must carry the pragma.
     */
    "checkJs": false,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",

    /*
     * Pinned so the emitted layout mirrors the repo (`lib/api.js` ->
     * `dist/types/lib/api.d.ts`) instead of shifting as `include` grows:
     * TS 6 fails declaration emit (TS5011) on an inferred common root.
     */
    "rootDir": ".",
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",

    /*
     * Several `lib/` modules `require()` JSON directly (`package.json` for the
     * version string, Ajv's draft-04 meta-schema, `conf/replacements.json`).
     * Without this they fail with TS2732.
     */
    "resolveJsonModule": true,

    /*
     * Third-party declarations are not this project's contract, and two of the
     * ones now reachable are broken in ways we cannot fix from here: espree's
     * `dist/espree.d.cts` re-exports its ESM entry, which is TS1479 under
     * `node16` CJS resolution, and `@eslint-community/eslint-utils` imports
     * from `"eslint"` — which resolves to this fork's own untyped `lib/api.js`
     * via the self-link in `node_modules`, so TS7016.
     */
    "skipLibCheck": true
  },

  /*
   * Expanded bead-by-bead as modules are annotated, so that `pnpm lint:types`
   * stays green after every individual merge. It cannot be literally empty:
   * tsc fails a zero-input project with TS18003, so it was seeded with a single
   * already-annotation-clean leaf module.
   *
   * `types/**` carries hand-written ambient declarations for dependencies that
   * ship no usable types of their own. Declaration files produce no output, so
   * including them does not disturb the `dist/types/` layout pinned above.
   */
  "include": [
    "lib/config/**/*.js",
    "lib/eslint/**/*.js",
    "lib/languages/**/*.js",
    "lib/linter/**/*.js",
    "lib/rule-tester/**/*.js",
    "lib/services/**/*.js",
    "lib/shared/**/*.js",
    "types/**/*.d.ts"
  ]
}
