{
  /*
   * The type-checking gate. `files` is the allowlist of JavaScript sources
   * that are annotated and must type-check clean under `strict: true`. It
   * grows bottom-up along the dependency graph — a module is added only once
   * everything it depends on is already annotated, so no shape is ever
   * asserted before it has been verified.
   *
   * Run with `npm run lint:types`. Every listed file must also carry a
   * `// @ts-check` pragma; `tests/lib/types/types.js` enforces that the two
   * lists agree.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "files": [
    // The hand-authored vocabulary and its escape hatches.
    "lib/types/core.d.ts",
    "lib/types/vendor.d.ts",

    // conf/
    "conf/ecma-version.js",

    // lib/shared/ — the leaf layer. Requires nothing else inside lib/.
    "lib/shared/ajv.js",
    "lib/shared/assert.js",
    "lib/shared/ast-utils.js",
    "lib/shared/deep-merge-arrays.js",
    "lib/shared/directives.js",
    "lib/shared/flags.js",
    "lib/shared/logging.js",
    "lib/shared/message-counts.js",
    "lib/shared/naming.js",
    "lib/shared/option-utils.js",
    "lib/shared/relative-module-resolver.js",
    "lib/shared/runtime-info.js",
    "lib/shared/serialization.js",
    "lib/shared/severity.js",
    "lib/shared/stats.js",
    "lib/shared/string-utils.js",
    "lib/shared/text-table.js",
    "lib/shared/translate-cli-options.js",
    "lib/shared/traverser.js",

    // lib/cli-engine/
    "lib/cli-engine/hash.js",

    // lib/linter/
    "lib/linter/interpolate.js",
    "lib/linter/timing.js",
    "lib/linter/code-path-analysis/id-generator.js",

    // lib/rules/utils/
    "lib/rules/utils/ast-utils.js",
    "lib/rules/utils/char-source.js",
    "lib/rules/utils/code-path-utils.js",
    "lib/rules/utils/fix-tracker.js",
    "lib/rules/utils/keywords.js",
    "lib/rules/utils/lazy-loading-rule-map.js",
    "lib/rules/utils/regular-expressions.js",
    "lib/rules/utils/unicode/index.js",
    "lib/rules/utils/unicode/is-combining-character.js",
    "lib/rules/utils/unicode/is-emoji-modifier.js",
    "lib/rules/utils/unicode/is-regional-indicator-symbol.js",
    "lib/rules/utils/unicode/is-surrogate-pair.js",

    // packages/js/ — no require edge into lib/, so it stands entirely alone.
    "packages/js/src/index.js",
    "packages/js/src/configs/eslint-all.js",
    "packages/js/src/configs/eslint-recommended.js"
  ],

  /*
   * Read by ts-node only; `tsc` ignores this top-level key entirely. It has
   * nothing to do with the gate above.
   *
   * Cypress loads `cypress.config.js` through its bundled ts-node but using
   * THIS project's TypeScript, and hard-codes `moduleResolution: "node"`
   * (node10). ts-node hooks `.js` files because this config tree sets
   * `allowJs`. Under TypeScript 6 that injected node10 is a hard error
   * (TS5107), and Cypress dies loading its config before a single spec runs.
   *
   * Keep the silencing scoped here. Putting `ignoreDeprecations` into
   * `compilerOptions` — in this file or in `tsconfig.base.json` — also makes
   * Cypress load and also leaves `tsc` at exit 0, but it would stop the real
   * type-check gate from reporting TypeScript deprecations, which is the one
   * thing in this repo that must keep shouting about them.
   *
   * `tests/lib/types/ci-config.js` pins both halves.
   */
  "ts-node": {
    "compilerOptions": {
      "ignoreDeprecations": "6.0"
    }
  }
}
