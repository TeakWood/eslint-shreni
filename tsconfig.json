{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "skipLibCheck": true
  },
  "include": [
    "lib/shared/**/*.js",
    "lib/config/**/*.js",
    "lib/rules/**/*.js",
    "lib/linter/*.js",
    "lib/linter/code-path-analysis/**/*.js",
    "lib/languages/**/*.js",
    "lib/services/**/*.js",
    "lib/eslint/**/*.js",
    "lib/rule-tester/**/*.js",
    "lib/cli-engine/**/*.js"
  ]
}
