{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // These entries are complementary to the ones found in package.json
      // `lib/eslint/worker.js` is a worker-thread entry point. It is loaded
      // only dynamically, via `pathToFileURL` at `lib/eslint/eslint.js`, which
      // Knip cannot follow. Upstream it stayed reachable through a static
      // `@import { WorkerLintResults } from "./worker.js"` JSDoc tag that the
      // baseline type strip removed.
      //
      // STOPGAP: delete this entry when `lib/eslint/eslint.js` is annotated in
      // phase 3+ and that `@import` tag returns, then confirm `knip` still
      // exits 0. Left in place, it masks `worker.js` from Knip forever. See
      // `.shreni/design/typescript-types-from-jsdoc.md`.
      "entry": [
        "lib/rules/index.js",
        "tools/internal-rules/*.js",
        "lib/eslint/worker.js",
      ],
      "project": ["{bin,conf,lib,tools}/**/*.js"],
      "mocha": {
        "entry": [
          "tests/{bin,conf,lib,messages,tools}/**/*.js", // see Makefile.js
        ],
        "project": ["tests/**/*.js"],
      },
      "ignore": [
        // If Knip would consider exports as named, their usage is too dynamic: globals[`es${ecmaVersion}`]
        // An alternative is to add `__esModule: true` to the export and we can remove it here from the ignores:
        "conf/globals.js",
        // These contain unresolved imports and other oddities:
        "tests/bench/large.js",
        "tests/performance/jshint.js",
        // Many are required using dynamic paths such as `fs.readFileSync(path.join())`:
        "tests/fixtures/**",
        // pnpm test package
        "tests/pnpm/**",
        // Run from Makefile.js
        "tools/generate-formatter-examples.js",
      ],
      "ignoreDependencies": [
        // Underlying code coverage engine used in unit tests
        "c8",
        // Consumed by the type-check gate rather than by any `require()`, so
        // Knip cannot see the reference. `eslint-scope`'s own declarations do
        // `import type * as ESTree from "estree"`; `skipLibCheck` is the only
        // reason that is not already an error. It is declared explicitly
        // because it otherwise reaches this repo only through a lint plugin's
        // dependency tree, where an unrelated upgrade can drop it.
        "@types/estree",
      ],
    },
    "docs": {
      "entry": ["src/assets/scss/{styles,print}.scss"],
      "ignore": ["src/assets/js/search.js", "_examples/**"],
    },
    "packages/js": {},
  },
}
